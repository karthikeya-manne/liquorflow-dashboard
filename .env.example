# Vite loads this file from the app root: liquorflow-dashboard-main/.env
# Use KEY=value lines only (not JavaScript objects).

# Firebase web app config (Firebase Console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LiquorFlow API (Express + MongoDB). Required after Firestore migration.
VITE_API_BASE_URL=http://localhost:5000
